{
  // Type-checks everything tsc's build doesn't: tests, scripts and the Vercel entries in
  // api/ and identity/api/.
  // Vitest doesn't type-check and Vercel bundles api/ with esbuild, so this is the only gate.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src", "tests", "scripts", "api", "identity", "*.ts"]
}
