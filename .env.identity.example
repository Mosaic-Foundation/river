# Every environment variable the identity host reads, by name. Values never go in git.
# Read them only through src/config/env.ts. `npm run dev:identity` reads .env.identity (gitignored).
#
# Local: DATABASE_URL points at the local Supabase stack as identity_app:
#   postgresql://identity_app:local-only@127.0.0.1:54322/postgres  (supabase/seed.sql sets the password)
# Hosted: postgresql://identity_app.[project-ref]:[password]@[pooler host]:6543/postgres?sslmode=verify-full
# Vercel (project `mosaic-id`): set for Production and Preview; only this project holds
# IDENTITY_MASTER_KEY and RESEND_API_KEY.
APP=identity
PORT=3001
DATABASE_URL=
# PEM of the CA behind the database's TLS certificate. Hosted Supabase needs it (verify-full
# against Supabase's own CA): Dashboard > Database > SSL Configuration. Unset locally.
DATABASE_CA_CERT=
SESSION_SECRET=
# 32 random bytes, base64. Never logged; Adam keeps an offline copy.
IDENTITY_MASTER_KEY=
# WebAuthn relying party ID: id.mosaic.social (locally: localhost)
RP_ID=
# The identity host's own origin. Local: http://localhost:3001
IDENTITY_PUBLIC_ORIGIN=
# Comma-separated exact River origins allowed to sign in. Local: http://localhost:5173,http://localhost:4173
RIVER_CLIENT_ORIGINS=
# log (one redacted line per email), capture (tests) or resend
EMAIL_TRANSPORT=
RESEND_API_KEY=
# e.g. Mosaic ID <id@mosaic.social>
EMAIL_FROM=
# Local runs and CI only; the app refuses to start when VERCEL is set (Vercel sets VERCEL itself;
# env.ts reads it, never set it by hand).
FETCH_FIXTURES_DIR=
TEST_ROUTES=
