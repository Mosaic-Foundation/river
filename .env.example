# Every environment variable the server reads, by name. Values never go in git.
# Read them only through src/config/env.ts.
#
# Local: copy to .env and fill from `npx supabase status -o env` (API_URL and SERVICE_ROLE_KEY,
# or SECRET_KEY on newer CLIs).
# Vercel: set in the project's Environment Variables, for Production and Preview.
PORT=3000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
