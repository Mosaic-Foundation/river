# Every environment variable the River reads, by name. Values never go in git.
# Read them only through src/config/env.ts. The identity host's list is .env.identity.example.
#
# Local: copy to .env (gitignored). DATABASE_URL points at the local Supabase stack as river_app:
#   postgresql://river_app:local-only@127.0.0.1:54322/postgres  (supabase/seed.sql sets the password)
# Vercel (project `river`): set for Production and Preview. DATABASE_URL uses the shared pooler:
#   postgresql://river_app.[project-ref]:[password]@[pooler host]:6543/postgres?sslmode=verify-full
# Any host but localhost always gets TLS with certificate checks (src/db/pool.ts).
APP=river
PORT=3000
DATABASE_URL=
# PEM of the CA behind the database's TLS certificate. Hosted Supabase needs it (verify-full
# against Supabase's own CA): Dashboard > Database > SSL Configuration. Unset locally.
DATABASE_CA_CERT=
# Signs the River's sign-in state and session cookies (HMAC-SHA256). At least 32 random
# characters, e.g. `openssl rand -hex 32`. Changing it signs everyone out.
SESSION_SECRET=
# The River's own origin (sign-in aud and redirect_uri, Origin checks). Local: http://localhost:5173
RIVER_PUBLIC_ORIGIN=
# The identity host's origin. Local: http://localhost:3001
IDENTITY_ORIGIN=
# Comma-separated DID hosts whose sign-in notes the River accepts, with the port if the DID has one.
# v1: id.mosaic.social. Local and CI: localhost:3001,localhost:3005 (the identity dev server, and
# the DID logs tests/api/signin.test.ts serves).
TRUSTED_DID_HOSTS=
# 32 random bytes, base64 (`openssl rand -base64 32`). Wraps the keys of the credentials the River
# holds to act for members (ADR-010 section 5). River project, Production only; never in the identity
# project. Local: any fresh value; only needed once acting is used.
RIVER_TOKEN_KEY=
# Comma-separated hostnames that get the seed instance (localhost, the River's vercel.app hosts)
INSTANCE_HOST_ALIASES=
# VERCEL_ENV is set by Vercel itself (production, preview, development); on a preview every host
# gets the seed instance. env.ts reads it; never set it by hand.
# Local runs and CI only; the app refuses to start when VERCEL is set (Vercel sets VERCEL itself;
# env.ts reads it, never set it by hand) or NODE_ENV is production.
FETCH_FIXTURES_DIR=
TEST_ROUTES=
# A fixed clock for the River's adapters (ISO 8601), so replayed hub feed URLs, which carry
# `since`, match the recordings. Local API/e2e runs and CI: 2026-10-21T00:00:00.000Z
# (tests/fixtures/civicHubClock.ts).
TEST_CLOCK_NOW=
# 1 lets the River read DID logs from a TRUSTED_DID_HOSTS host on loopback over http (the identity
# dev server), since the fetch guard refuses http and loopback. Local runs and CI only.
TEST_DID_LOOPBACK=
# 1 sends the River's fediverse acting requests (linking accounts) to the stand-in server in
# tests/support/standInMastodon/ instead of the network; with TEST_ROUTES=1 it also mounts
# /api/test/stand-in-fediverse/*, which drives it. Local API/e2e runs and CI only.
TEST_STAND_IN_FEDIVERSE=
